# Copie este arquivo para ".env" e preencha com os dados reais.
# O arquivo .env NUNCA deve ir para o GitHub.

PORT=3000

DB_SERVER=endereco-do-servidor
DB_PORT=1433
DB_DATABASE=PBS_ACAIBN_DADOS
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# Chave de acesso da API (gere uma aleatória, veja o README)
API_KEY=troque-por-uma-chave-aleatoria
# Chaves por setor (opcionais): entregue só a do setor de cada pessoa
# API_KEY_VENDAS=...
# API_KEY_FINANCEIRO=...
# API_KEY_ADMIN=...      administrativo: usuários e rastreio de uso do PROCFIT
# API_KEY_FATURAMENTO=...  faturamento: análise de pedidos
